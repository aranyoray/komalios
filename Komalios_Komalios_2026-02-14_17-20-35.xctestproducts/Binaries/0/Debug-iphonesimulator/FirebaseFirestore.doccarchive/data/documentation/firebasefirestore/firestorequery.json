{"abstract":[{"text":"A property wrapper that listens to a Firestore collection.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/firebase-ios-sdk.FirebaseFirestore\/s8SendableP","doc:\/\/firebase-ios-sdk.FirebaseFirestore\/7SwiftUI15DynamicPropertyP"],"kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebasefirestore\/firestorequery"]}],"identifier":{"url":"doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirestoreQuery","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","metadata":{"navigatorTitle":[{"kind":"identifier","text":"FirestoreQuery"}],"roleHeading":"Structure","title":"FirestoreQuery","modules":[{"name":"FirebaseFirestore"}],"symbolKind":"struct","externalID":"s:17FirebaseFirestore0B5QueryV","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"FirestoreQuery","kind":"identifier"}],"platforms":[{"deprecated":false,"beta":false,"introducedAt":"14.0","name":"iOS","unavailable":false},{"deprecated":false,"beta":false,"introducedAt":"14.0","name":"iPadOS","unavailable":false},{"beta":false,"introducedAt":"14.0","deprecated":false,"name":"Mac Catalyst","unavailable":false},{"beta":false,"introducedAt":"11.0","deprecated":false,"name":"macOS","unavailable":false},{"introducedAt":"14.0","unavailable":false,"beta":false,"name":"tvOS","deprecated":false},{"name":"watchOS","introducedAt":"7.0","deprecated":false,"unavailable":false,"beta":false}],"role":"symbol"},"topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirestoreQuery\/Configuration"],"generated":true},{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirestoreQuery\/init(collectionPath:predicates:decodingFailureStrategy:animation:)-6qxqh","doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirestoreQuery\/init(collectionPath:predicates:decodingFailureStrategy:animation:)-9nyk3"],"generated":true},{"generated":true,"identifiers":["doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirestoreQuery\/projectedValue","doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirestoreQuery\/wrappedValue"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirestoreQuery\/DynamicProperty-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@propertyWrapper"},{"text":" ","kind":"text"},{"kind":"attribute","text":"@"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"FirestoreQuery","kind":"identifier"},{"kind":"text","text":"<"},{"text":"T","kind":"genericParameter"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"In the following example, "},{"code":"FirestoreQuery","type":"codeVoice"},{"type":"text","text":" will fetch all documents from the"},{"type":"text","text":" "},{"code":"fruits","type":"codeVoice"},{"type":"text","text":" collection, filtering only documents whose "},{"code":"isFavourite","type":"codeVoice"},{"type":"text","text":" attribute"},{"type":"text","text":" "},{"type":"text","text":"is equal to "},{"code":"true","type":"codeVoice"},{"type":"text","text":", map members of result set to the "},{"code":"Fruit","type":"codeVoice"},{"type":"text","text":" type, and make"},{"type":"text","text":" "},{"type":"text","text":"them available via the wrapped value "},{"code":"fruits","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["struct ContentView: View {","  @FirestoreQuery(","    collectionPath: \"fruits\",","    predicates: [.whereField(\"isFavourite\", isEqualTo: true)]","  ) var fruits: [Fruit]","","  var body: some View {","    List(fruits) { fruit in","      Text(fruit.name)","    }","  }","}"]},{"inlineContent":[{"code":"FirestoreQuery","type":"codeVoice"},{"type":"text","text":" also supports returning a "},{"code":"Result","type":"codeVoice"},{"type":"text","text":" type. The "},{"code":".success","type":"codeVoice"},{"type":"text","text":" case"},{"type":"text","text":" "},{"type":"text","text":"returns an array of elements, whereas the "},{"code":".failure","type":"codeVoice"},{"type":"text","text":" case returns an error"},{"type":"text","text":" "},{"type":"text","text":"in case mapping the Firestore documents wasn’t successful:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["struct ContentView: View {","  @FirestoreQuery(","    collectionPath: \"fruits\",","    predicates: [.whereField(\"isFavourite\", isEqualTo: true)]","  ) var fruitResults: Result<[Fruit], Error>","","var body: some View {","  if case let .success(fruits) = fruitResults {","    List(fruits) { fruit in","      Text(fruit.name)","    }","  } else if case let .failure(error) = fruitResults {","    Text(\"Couldn't map data: \\(error.localizedDescription)\")","  }","}"]},{"inlineContent":[{"type":"text","text":"Alternatively, the "},{"inlineContent":[{"type":"text","text":"projected value"}],"type":"emphasis"},{"type":"text","text":" of the property wrapper provides access to"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"error"},{"type":"text","text":" as well. This allows you to display a list of all successfully mapped"},{"type":"text","text":" "},{"type":"text","text":"documents, as well as an error message with details about the documents that couldn’t"},{"type":"text","text":" "},{"type":"text","text":"be mapped successfully (e.g. because of a field name mismatch)."}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["struct ContentView: View {","  @FirestoreQuery(","    collectionPath: \"mappingFailure\",","    decodingFailureStrategy: .ignore","  ) private var fruits: [Fruit]","","  var body: some View {","    VStack(alignment: .leading) {","      List(fruits) { fruit in","        Text(fruit.name)","      }","      if $fruits.error != nil {","        HStack {","          Text(\"There was an error\")","            .foregroundColor(Color(UIColor.systemBackground))","          Spacer()","        }","        .padding(30)","        .background(Color.red)","      }","    }","  }","}"]},{"inlineContent":[{"type":"text","text":"Internally, "},{"code":"@FirestoreQuery","type":"codeVoice"},{"type":"text","text":" sets up a snapshot listener and publishes"},{"type":"text","text":" "},{"type":"text","text":"any incoming changes via an "},{"code":"@StateObject","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The projected value of this property wrapper provides access to a"},{"type":"text","text":" "},{"type":"text","text":"configuration object of type "},{"code":"FirestoreQueryConfiguration","type":"codeVoice"},{"type":"text","text":" which can be used"},{"type":"text","text":" "},{"type":"text","text":"to modify the query criteria. Changing the filter predicates results in the"},{"type":"text","text":" "},{"type":"text","text":"underlying snapshot listener being unregistered and a new one registered."}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["Button(\"Show only Apples and Oranges\") {","  $fruits.predicates = [.whereField(\"name\", isIn: [\"Apple\", \"Orange]]","}"]},{"inlineContent":[{"type":"text","text":"This property wrapper does not support updating the "},{"code":"wrappedValue","type":"codeVoice"},{"type":"text","text":", i.e."},{"type":"text","text":" "},{"type":"text","text":"you need to use Firestore’s other APIs to add, delete, or modify documents."}],"type":"paragraph"}]}],"references":{"doc://firebase-ios-sdk.FirebaseFirestore/documentation/FirebaseFirestore/FirestoreQuery/projectedValue":{"role":"symbol","identifier":"doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirestoreQuery\/projectedValue","title":"projectedValue","kind":"symbol","url":"\/documentation\/firebasefirestore\/firestorequery\/projectedvalue","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"projectedValue"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17FirebaseFirestore0B5QueryV13ConfigurationV","kind":"typeIdentifier","text":"Configuration"}],"abstract":[{"type":"text","text":"A binding to the request’s mutable configuration properties"}]},"doc://firebase-ios-sdk.FirebaseFirestore/documentation/FirebaseFirestore/FirestoreQuery/Configuration":{"navigatorTitle":[{"kind":"identifier","text":"Configuration"}],"role":"symbol","identifier":"doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirestoreQuery\/Configuration","title":"FirestoreQuery.Configuration","kind":"symbol","url":"\/documentation\/firebasefirestore\/firestorequery\/configuration","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Configuration"}],"abstract":[{"type":"text","text":"The query’s configurable properties."}]},"doc://firebase-ios-sdk.FirebaseFirestore/documentation/FirebaseFirestore":{"role":"collection","identifier":"doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documenta