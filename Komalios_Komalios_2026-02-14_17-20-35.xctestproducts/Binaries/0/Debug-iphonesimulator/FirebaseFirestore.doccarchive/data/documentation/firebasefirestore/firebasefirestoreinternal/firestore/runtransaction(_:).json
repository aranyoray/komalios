{"abstract":[{"text":"Executes the given updateBlock and then attempts to commit the changes applied within an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"atomic"},{"type":"text","text":" "},{"type":"text","text":"transaction."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/firebasefirestore\/firebasefirestoreinternal\/firestore\/runtransaction(_:)"]}],"identifier":{"url":"doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirebaseFirestoreInternal\/Firestore\/runTransaction(_:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","metadata":{"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runTransaction"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)FIRTransaction","text":"Transaction"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation14NSErrorPointera","text":"NSErrorPointer"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"Any"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"keyword","text":"Any"},{"kind":"text","text":"?"}],"platforms":[{"unavailable":false,"deprecated":false,"introducedAt":"13.0","name":"iOS","beta":false},{"unavailable":false,"deprecated":false,"introducedAt":"13.0","name":"iPadOS","beta":false},{"unavailable":false,"deprecated":false,"introducedAt":"13.0","name":"Mac Catalyst","beta":false},{"unavailable":false,"deprecated":false,"introducedAt":"10.15","name":"macOS","beta":false},{"unavailable":false,"deprecated":false,"introducedAt":"13.0","name":"tvOS","beta":false},{"unavailable":false,"deprecated":false,"introducedAt":"7.0","name":"watchOS","beta":false}],"role":"symbol","externalID":"s:So12FIRFirestoreC17FirebaseFirestoreE14runTransactionyypSgAESo14FIRTransactionC_SAySo7NSErrorCSgGSgtcYaKF","extendedModule":"FirebaseFirestoreInternal","modules":[{"name":"FirebaseFirestore","relatedModules":["FirebaseFirestoreInternal"]}],"title":"runTransaction(_:)","roleHeading":"Instance Method"},"sections":[],"hierarchy":{"paths":[["doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore","doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirebaseFirestoreInternal","doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirebaseFirestoreInternal\/Firestore"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runTransaction","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"updateBlock","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"attribute"},{"text":" (","kind":"text"},{"text":"Transaction","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)FIRTransaction"},{"text":", ","kind":"text"},{"text":"NSErrorPointer","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation14NSErrorPointera"},{"text":") -> ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The maximum number of writes allowed in a single transaction is 500, but note that each","type":"text"},{"text":" ","type":"text"},{"text":"usage of","type":"text"},{"text":" ","type":"text"},{"code":"FieldValue.serverTimestamp()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FieldValue.arrayUnion()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FieldValue.arrayRemove()","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"code":"FieldValue.increment()","type":"codeVoice"},{"text":" inside a transaction counts as an additional write.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In the ","type":"text"},{"code":"updateBlock","type":"codeVoice"},{"text":", a set of reads and writes can be performed atomically using the","type":"text"},{"text":" ","type":"text"},{"code":"Transaction","type":"codeVoice"},{"text":" object passed to the block. After the ","type":"text"},{"code":"updateBlock","type":"codeVoice"},{"text":" is run, Firestore will","type":"text"},{"text":" ","type":"text"},{"text":"attempt","type":"text"},{"text":" ","type":"text"},{"text":"to apply the changes to the server. If any of the data read has been modified outside of","type":"text"},{"text":" ","type":"text"},{"text":"this","type":"text"},{"text":" ","type":"text"},{"text":"transaction since being read, then the transaction will be retried by executing the","type":"text"},{"text":" ","type":"text"},{"code":"updateBlock","type":"codeVoice"},{"text":" ","type":"text"},{"text":"again. If the transaction still fails after 5 retries, then the transaction will fail.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Since the ","type":"text"},{"code":"updateBlock","type":"codeVoice"},{"text":" may be executed multiple times, it should avoiding doing anything","type":"text"},{"text":" ","type":"text"},{"text":"that","type":"text"},{"text":" ","type":"text"},{"text":"would cause side effects.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Any value maybe be returned from the ","type":"text"},{"code":"updateBlock","type":"codeVoice"},{"text":". If the transaction is successfully","type":"text"},{"text":" ","type":"text"},{"text":"committed,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"then the completion block will be passed that value. The "},{"type":"codeVoice","code":"updateBlock"},{"type":"text","text":" also has an "},{"type":"codeVoice","code":"NSError"},{"type":"text","text":" "},{"type":"text","text":"out"},{"type":"text","text":" "},{"type":"text","text":"parameter. If this is set, then the transaction will not attempt to commit, and the given"},{"type":"text","text":" "},{"type":"text","text":"error"},{"type":"text","text":" "},{"type":"text","text":"will be returned."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Transaction"},{"type":"text","text":" object passed to the "},{"type":"codeVoice","code":"updateBlock"},{"type":"text","text":" contains methods for accessing"},{"type":"text","text":" "},{"type":"text","text":"documents"},{"type":"text","text":" "},{"type":"text","text":"and collections. Unlike other firestore access, data accessed with the transaction will not"},{"type":"text","text":" "},{"type":"text","text":"reflect local changes that have not been committed. For this reason, it is required that all"},{"type":"text","text":" "},{"type":"text","text":"reads are performed before any writes. Transactions must be performed while online."},{"type":"text","text":" "},{"type":"text","text":"Otherwise,"},{"type":"text","text":" "},{"type":"text","text":"reads will fail, the final commit will fail, and this function will return an error."}]},{"items":[{"content":[{"inlineContent":[{"text":"Parameter updateBlock The block to execute within the transaction context.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Throws Throws an error if the transaction could not be committed, or if an error was","type":"text"},{"text":" ","type":"text"},{"text":"explicitly specified in the ","type":"text"},{"type":"codeVoice","code":"updateBlock"},{"text":" parameter.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns Returns the value returned in the "},{"code":"updateBlock","type":"codeVoice"},{"type":"text","text":" parameter if no errors occurred."}]}]}],"type":"unorderedList"}]}],"references":{"doc://firebase-ios-sdk.FirebaseFirestore/documentation/FirebaseFirestore/FirebaseFirestoreInternal/Firestore/runTransaction(_:)":{"abstract":[{"type":"text","text":"Executes the given updateBlock and then attempts to commit the changes applied within an"},{"type":"text","text":" "},{"type":"text","text":"atomic"},{"type":"text","text":" "},{"type":"text","text":"transaction."}],"title":"runTransaction(_:)","type":"topic","url":"\/documentation\/firebasefirestore\/firebasefirestoreinternal\/firestore\/runtransaction(_:)","identifier":"doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore\/FirebaseFirestoreInternal\/Firestore\/runTransaction(_:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runTransaction","kind":"identifier"},{"text":"((","kind":"text"},{"text":"Transaction","preciseIdentifier":"c:objc(cs)FIRTransaction","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"NSErrorPointer","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation14NSErrorPointera"},{"text":") -> ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"?","kind":"text"}],"role":"symbol"},"doc://firebase-ios-sdk.FirebaseFirestore/documentation/FirebaseFirestore":{"role":"collection","identifier":"doc:\/\/firebase-ios-sdk.FirebaseFirestore\/documentation\/FirebaseFirestore","title":"FirebaseFirestore","kind":"symbol","url":"\/documentation\/firebasefirestore","type":"topic","abstract":[]},"doc://firebase-ios-sdk.FirebaseFirestore/documentation/FirebaseFirestore/FirebaseFirestoreInternal":{"abstract":[],"title":"Firebase