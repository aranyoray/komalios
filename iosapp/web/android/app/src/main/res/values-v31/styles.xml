<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ specific splash screen attributes -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- White background (API 31+) -->
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:background">@drawable/splash_white</item>
        <!-- Hide the icon completely by using transparent drawable (API 31+) -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <!-- Remove branding image (API 31+) -->
        <item name="android:windowSplashScreenBrandingImage">@null</item>
        <!-- Post splash theme -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
    
    <!-- API 31+ theme with edge-to-edge support -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Use edge-to-edge API instead of deprecated status/navigation bar color setters -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Ensure proper light/dark status bar appearance -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>

