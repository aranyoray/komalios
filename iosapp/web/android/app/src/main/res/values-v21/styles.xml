<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 21+ specific attributes for edge-to-edge support -->
    <!-- android:statusBarColor requires API level 21 (Android 5.0) -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Edge-to-edge: Set status bar to transparent so content extends behind it -->
        <!-- This attribute requires API 21+ (Android 5.0+) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Ensure content extends behind system bars for edge-to-edge -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>

